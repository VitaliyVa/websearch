{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // "node" потрібен для vite.config.ts, який читає process.env.
    // Локально збірка проходила через типи кореневого проєкту, а в чистому
    // клоні CI падала з "Cannot find name 'process'".
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}

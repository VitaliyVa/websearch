# ─────────────────────────────────────────────────────────────
# Google Cloud — ОКРЕМИЙ проєкт під цей пайплайн.
# Увімкнути API: Places API (New), PageSpeed Insights API,
#                Google Sheets API, Google Drive API
# Обов'язково постав Budget Alert на $20.
# ─────────────────────────────────────────────────────────────

# API-ключ з рестрикшеном "Places API (New)" (Application restrictions: None або твій IP)
GOOGLE_PLACES_KEY=

# Окремий ключ з рестрикшеном "PageSpeed Insights API"
GOOGLE_PSI_KEY=

# ─────────────────────────────────────────────────────────────
# Google Sheets — service account
# 1. IAM & Admin -> Service Accounts -> Create -> Keys -> Add key -> JSON
# 2. Розшар цільову таблицю на email сервісного акаунта з правами Editor
# ─────────────────────────────────────────────────────────────

GOOGLE_SA_EMAIL=
# Приватний ключ з JSON, у лапках, з \n як literal (скрипт сам їх розгортає)
GOOGLE_SA_PRIVATE_KEY=""

# ID таблиці з URL: docs.google.com/spreadsheets/d/<ЦЕЙ_ID>/edit
GOOGLE_SHEET_ID=

# ─────────────────────────────────────────────────────────────
# Опційно
# ─────────────────────────────────────────────────────────────

# Ліміт витрат: скрипт зупиняється, коли перевищено (страховка від бага в циклі)
MAX_PLACES_REQUESTS=4500
MAX_DETAILS_REQUESTS=900

# Конкурентність фетчу сайтів
FETCH_CONCURRENCY=8

# Свій контакт у User-Agent — ввічливість, зменшує шанс бану
CRAWLER_CONTACT=vistet1428@gmail.com
